{
  "name": "sipp-monitoring",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --max-old-space-size=8192 ./node_modules/nuxt/bin/nuxt.mjs build",
    "dev": "node --max-old-space-size=8192 ./node_modules/nuxt/bin/nuxt.mjs dev",
    "generate": "node --max-old-space-size=8192 ./node_modules/nuxt/bin/nuxt.mjs generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull"
  },
  "dependencies": {
    "@nuxt/ui": "^2.21.0",
    "@prisma/client": "^6.4.1",
    "@vueuse/core": "^12.7.0",
    "chart.js": "^4.4.8",
    "exceljs": "^4.4.0",
    "vue-chartjs": "^5.3.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nuxt/icon": "^1.10.3",
    "@types/node": "^22.13.5",
    "nuxt": "^3.15.4",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3"
  }
}
