# ==========================================
# Production Environment Variables
# ==========================================

# Port aplikasi di server host
PORT=3000

# URL Koneksi Database MySQL / MariaDB SIPP
# Jika MySQL berjalan di host server yang sama dengan Docker:
DATABASE_URL="mysql://root:password@host.docker.internal:3306/sipppaju"
# Jika MySQL berjalan di server database terpisah:
# DATABASE_URL="mysql://user_sipp:password_sipp@192.168.0.200:3306/sipp"

# Konfigurasi Enkripsi API (jika menggunakan microservice enkripsi)
ENCRYPT_API_URL="http://192.168.0.141:8080"
ENCRYPT_API_KEY=""

# Base URL Aplikasi SIPP Web Pengadilan
SIPP_BASE_URL="http://192.168.0.222/SIPP"
